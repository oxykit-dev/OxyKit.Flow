            {
              "key": "Content-Type",
              "value": "application/json",
              "active": true,
              "description": ""
            },
            {
              "key": "Idempotency-Key",
              "value": "hoppscotch-smoke-1",
              "active": true,
              "description": "Change to re-create; same key returns existing job"
