          ],
          "preRequestScript": "",
          "testScript": "pw.test(\"status is 200 or 201\", () => {\n  const s = pw.response.status;\n  pw.expect(s === 200 || s === 201).toBe(true);\n});\npw.test(\"returns job id\", () => {\n  pw.expect(typeof pw.response.body.id).toBe(\"string\");\n  pw.env.set(\"jobId\", pw.response.body.id);\n});\n",
          "auth": {
            "authType": "inherit",
            "authActive": true
          },
          "body": {
            "contentType": "application/json",
            "body": "{\n  \"name\": \"hoppscotch-smoke\",\n  \"render\": {\n    \"input\": \"table\",\n    \"output\": \"html\",\n    \"body\": {\n      \"sheets\": [\n        {\n          \"name\": \"Orders\",\n          \"headers\": [\n            \"Id\",\n            \"Customer\"\n          ],\n          \"rows\": [\n            [\n              1,\n              \"Acme\"\n            ],\n            [\n              2,\n              \"Beta\"\n            ]\n          ]\n        }\n      ]\n    }\n  },\n  \"outputs\": [\n    {\n      \"provider\": \"file\",\n      \"destination\": \"output/hoppscotch_smoke.html\"\n    }\n  ]\n}"
          },
          "requestVariables": [],
          "responses": {},
