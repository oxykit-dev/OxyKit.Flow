<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <Version>0.1.0</Version>
    <Authors>OxyKit</Authors>
    <Description>OxyKit.Flow job orchestrator — render + deliver via HTTP engines and output providers.</Description>
    <PackageProjectUrl>https://oxykit.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/oxykit-dev/OxyKit.Flow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>
    <UserSecretsId>dotnet-OxyKit.Flow-ad34ded3-932f-421f-9f34-6edc1e51892f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ErrorOr" Version="2.1.1" />
    <PackageReference Include="FastEndpoints" Version="8.3.0" />
    <PackageReference Include="FastEndpoints.Swagger" Version="8.3.0" />
    <PackageReference Include="FluentFTP" Version="55.1.0" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
    <PackageReference Include="OxyKit.Render.Client" Version="0.1.2" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <ProjectReference Include="..\OxyKit.Flow.Abstractions\OxyKit.Flow.Abstractions.csproj" />
  </ItemGroup>
</Project>
