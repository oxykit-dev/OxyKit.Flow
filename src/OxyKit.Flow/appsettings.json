{
  "DatabaseProvider": "SQLite",
  "ConnectionStrings": {
    "SQLiteConnection": "Data Source=data/oxykit-flow.db",
    "PostgreSQLConnection": "Host=localhost;Database=oxykit_flow;Username=oxykit;Password="
  },
  "Security": {
    "ApiKeyHeader": "X-OxyKit-Flow-Key",
    "ApiKey": ""
  },
  "Jobs": {
    "PollIntervalSeconds": 2,
    "BatchSize": 5,
    "DefaultMaxAttempts": 3,
    "ProcessingTimeoutSeconds": 300
  },
  "Render": {
    "Engines": {
      "oxykit-render": {
        "Kind": "oxykit",
        "BaseAddress": "http://localhost:5066/",
        "ApiKey": ""
      }
    }
  },
  "OxyKit.Mail": {
    "BaseAddress": "http://localhost:5026/",
    "ApiKey": "",
    "ApiKeyHeader": "X-Api-Key",
    "DefaultSubject": "Report: {fileName}",
    "DefaultBody": "Please find the attached report.",
    "DefaultIsHtml": false
  },
  "Outputs": {
    "Transfer": {
      "Profiles": {
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
