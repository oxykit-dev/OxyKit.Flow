# Copy to .env and fill in real values. Never commit .env.
# docker compose up --build

# --- Shared API keys (dev defaults OK for local compose) ---
RENDER_API_KEY=dev-local-key
FLOW_API_KEY=dev-flow-key

# Sender (or Admin) API key from Mail after bootstrap — required for Flow mail output.
# Leave empty for file-only smoke. Until set + `docker compose up -d flow`, mail jobs
# fail at delivery (empty OxyKit.Mail:ApiKey). SMTP can be Unhealthy; Mail may still accept.
# Quote the value if it contains '=', '+', or '/' (Mail keys are "{guid}.{base64}"):
# FLOW_MAIL_API_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.xxxxx+xx="
FLOW_MAIL_API_KEY=

# --- OxyKit.Mail (external SMTP; no local SMTP container) ---
DatabaseProvider=SQLite
Jwt__Key=change-me-to-a-jwt-signing-key-at-least-32-chars
Jwt__Issuer=OxyKit.Mail
Jwt__Audience=OxyKit.Mail
# Non-empty required for Mail to start (use real provider values for actual delivery)
SmtpSettings__Host=smtp.example.com
SmtpSettings__Port=587
SmtpSettings__Username=your-username
SmtpSettings__Password=your-password
SmtpSettings__EnableSsl=true
SmtpSettings__AuthMode=Password

# --- Optional mail-web (compose --profile ui) ---
VITE_BACKEND_URL=http://localhost:5026
VITE_SIGNALR_HUB_URL=http://localhost:5026/hubs
